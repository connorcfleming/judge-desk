# Copy to .env and fill in. NEVER commit .env. Code reads these from the environment only.
SOLANA_BURNER_PRIVATE_KEY=
HELIUS_API_KEY=
# Optional public RPC fallback when HELIUS_API_KEY is empty
WHALE_RPC=
BIRDEYE_API_KEY=
# Alternatively a file containing the Birdeye key (default ~/.birdeye_key)
BIRDEYE_KEY_FILE=
# Jev judge: called via the Composio MCP (Claude Code tool), not from Python.
# Configure the Composio MCP server in Claude Code; no key is needed here.
COMPOSIO_API_KEY=
